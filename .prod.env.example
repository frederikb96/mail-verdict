# MailVerdict Production Environment
# Copy to .prod.env and fill in values
# Usage: podman compose --env-file .prod.env up -d

# Provider API keys for spam classification and rule enrichment. Both are
# optional at startup -- set a default provider with no key configured and
# classification just fails loudly and skips, logged, until one is set.
# Prefer setting these through the running application's Settings API
# instead (stored encrypted, no restart needed); these env vars are the
# fallback for a deployment that prefers keeping keys out of the database.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Encrypts provider API keys stored via the Settings API, and PostIMAP's
# own credential-at-rest encryption -- one key, shared by both consumers of
# this deployment (AES-256-GCM, 64 hex chars / 32 bytes).
# Generate: python -c "import os; print(os.urandom(32).hex())"
ENCRYPTION_KEY=

# Database password (use a strong password for production)
POSTGRES_PASSWORD=

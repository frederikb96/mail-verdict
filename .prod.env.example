# MailVerdict Production Environment
# Copy to .prod.env and fill in values
# Usage: podman compose --env-file .prod.env up -d

# Anthropic API key for AI verdict classification
ANTHROPIC_API_KEY=

# API key for MailVerdict's own /api/* and /mcp auth. Empty disables auth (dev mode).
MAIL_VERDICT_API_KEY=

# PostIMAP's own credential-at-rest encryption key (AES-256-GCM, 64 hex
# chars / 32 bytes). MailVerdict itself never touches this -- consumers
# always write plaintext credentials, PostIMAP encrypts them.
# Generate: python -c "import os; print(os.urandom(32).hex())"
ENCRYPTION_KEY=

# Database password (use a strong password for production)
POSTGRES_PASSWORD=

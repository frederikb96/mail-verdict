# MailVerdict Development Environment
# Copy to .dev.env and fill in values
# Usage: podman compose --env-file .dev.env -f compose.dev.yaml up -d

# Provider API keys for spam classification and rule enrichment. Optional
# at startup -- set through the Settings API once the app is running
# instead, if you'd rather not keep a key in this file.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Encrypts provider API keys stored via the Settings API, and PostIMAP's
# own credential-at-rest encryption -- one key, shared by both (AES-256-GCM,
# 64 hex chars / 32 bytes).
# Generate: python -c "import os; print(os.urandom(32).hex())"
ENCRYPTION_KEY=

# Database password (dev uses simple password, matches compose.dev.yaml)
POSTGRES_PASSWORD=devpass

# Password for the throwaway dev mail server (Dovecot). Any username
# authenticates with this one password -- use it as the IMAP password when
# adding an account through the interface, after seeding mail with
# scripts/seed_dev.py.
MAIL_PASSWORD=devmailpass
